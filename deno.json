{
  "tasks": {
    "check": "deno fmt $(git diff --cached --name-only | grep .ts) && deno lint --fix $(git diff --cached --name-only | grep .ts) ",
    "check-web": "cd web && deno check",
    "check-service": "cd service && deno check",
    "hooks:install": "deno run --allow-read=deno.json,.git/hooks/ --allow-write=.git/hooks/ jsr:@hongminhee/deno-task-hooks",
    "hooks:pre-commit": "deno task check",
    "deno-check": "deno task check-web && deno task check-service",
    "databasetestsetup": "deno run --allow-all service/test/DenoDbTests/DenoDBTestDatabaseSetup.ts"
  },
  "imports": {
    "@std/encoding": "jsr:@std/encoding",
    "@ant-design/icons": "npm:@ant-design/icons@^6.1.0",
    "@denodb/datatypes": "https://deno.land/x/denodb@v1.4.0/lib/data-types.ts",
    "@std/testing": "jsr:@std/testing@^1.0.16",
    "@denodb": "https://deno.land/x/denodb@v1.4.0/mod.ts",
    "react-router-dom": "npm:react-router-dom@7.9.4",
    "react-dom/client": "npm:react-dom@19.2.0/client",
    "react": "npm:react@19.2.0",
    "vite/client": "npm:vite@7.1.9/client",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@5.0.4",
    "vite": "npm:vite@7.1.9",
    "antd": "npm:antd",
    "@hono/hono": "jsr:@hono/hono@^4.9.10",
    "@hono/hono/cors": "jsr:@hono/hono@^4.9.10/cors",
    "@std/assert": "https://deno.land/std@0.224.0/assert/mod.ts",
    "@jackfiszr/faker": "jsr:@jackfiszr/faker@1.1.6",
    "https://deno.land/std@0.224.0/crypto/_wasm/lib/deno_std_wasm_crypto.generated.d.mts": "data:text/typescript,export {}",
    "@std/hash": "https://deno.land/std@0.114.0/hash/sha256.ts"
  },
  "scopes": {
    "https://raw.githubusercontent.com/Zhomart/dex/": {
      "https://deno.land/std/node/events.ts": "node:events",
      "https://deno.land/std/node/assert.ts": "node:assert",
      "https://deno.land/std/node/url.ts": "node:url",
      "https://deno.land/std/node/stream.ts": "node:stream",
      "https://deno.land/std/node/util.ts": "node:util"
    }
  }
}
